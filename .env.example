# Copy to .env.local (local) or set in Vercel Project Settings -> Environment Variables.
# NEVER commit real values.

# --- Public identifiers (safe to expose; bundled into the browser) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=mkiaioc7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Canonical origin used for canonical URLs, sitemap, RSS, Open Graph. Production: the real domain.
NEXT_PUBLIC_SITE_URL=https://www.online24taas.com

# --- Secrets (server only; never prefix with NEXT_PUBLIC_) ---
# Needed only if the dataset is private. Viewer-role token. Not needed for a public dataset.
SANITY_API_READ_TOKEN=
# HMAC secret shared with the Sanity webhook that calls POST /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Contact form delivery (replacement for Contact Form 7). Without these /api/contact answers 503.
SMTP_URL=
CONTACT_TO=
CONTACT_FROM=

# --- Migration scripts only (local machine, never on Vercel) ---
# Editor-role token for the target project, or use `--use-cli-auth` after `npx sanity login`.
SANITY_API_WRITE_TOKEN=
