# Copy to .env.local (local) or set in Vercel Project Settings -> Environment Variables. NEVER commit real values.
# Which variables exist, where they are read, and who may see them:

# --- Public identifiers (safe to expose; bundled into the browser) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=mkiaioc7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Canonical origin for canonical URLs, sitemap, RSS and Open Graph. Production: the real domain.
# Leave UNSET on Vercel Preview: previews then use their own https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=https://www.online24taas.com

# --- Secrets (server only; never prefix with NEXT_PUBLIC_) ---
# Only if the dataset is private (Viewer token). The production dataset is public-read, so leave empty.
SANITY_API_READ_TOKEN=
# HMAC secret shared with the Sanity webhook that calls POST /api/revalidate. Generate: openssl rand -hex 32
# Use a different value for Production and Preview.
SANITY_REVALIDATE_SECRET=
# Contact form delivery (replaces Contact Form 7). Without SMTP_URL + CONTACT_TO, /api/contact answers 503.
#   SMTP_URL      smtps://USER:PASSWORD@smtp.example.com:465   (URL-encode special characters in the password)
#   CONTACT_TO    mailbox that receives the messages
#   CONTACT_FROM  sender address the SMTP account may send from (defaults to CONTACT_TO)
SMTP_URL=
CONTACT_TO=
CONTACT_FROM=
# Exact ads.txt text from the AdSense console (Sites > ads.txt). Separate lines with \n. Unset => /ads.txt is 404.
#   Example shape only: ADS_TXT=google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0
ADS_TXT=

# --- Migration / maintenance scripts only (local machine, never on Vercel) ---
# Editor-role token for the target project, or use `--use-cli-auth` after `npx sanity login`.
SANITY_API_WRITE_TOKEN=
