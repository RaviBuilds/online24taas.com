{
  "name": "online24taas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate:parse": "python3 migration/parse_wp_sql.py \"${WP_SQL:-../online24taas/APP-DATA.SQL}\" migration/work",
    "migrate:normalize": "node migration/normalize.mjs",
    "migrate:prepare": "npm run migrate:parse && npm run migrate:normalize",
    "migrate:upload": "node migration/upload-assets.mjs",
    "migrate:bundle": "node migration/build-bundle.mjs",
    "migrate:validate": "node migration/validate-bundle.mjs",
    "migrate:import": "node migration/import.mjs",
    "migrate:verify": "node migration/verify.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/integration/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:server": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/server/*.test.mjs\"",
    "studio:login": "node tools/studio-login.mjs",
    "test:studio": "playwright test e2e/studio-ui.spec.ts --project=desktop --workers=1"
  },
  "dependencies": {
    "@portabletext/react": "^3.2.0",
    "@sanity/icons": "^3.5.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.68.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.5.28",
    "next-sanity": "^9.8.0",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.1",
    "sanity": "^3.68.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@sanity/client": "^7.28.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.16.2",
    "entities": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "parse5": "^7.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  }
}
